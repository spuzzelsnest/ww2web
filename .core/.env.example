APP_NAME=ww2maps
APP_ENV=local
APP_KEY=                        # php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Shown in the footer of the map page
LAST_UPDATE=13/10/2026

# Free key: carto.com/basemaps
CARTO_API_KEY=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ww2maps_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=laravel_session
# Set to true on the live (HTTPS) site
SESSION_SECURE_COOKIE=false

CACHE_STORE=file
CACHE_PREFIX=laravel
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
