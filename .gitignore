# Dependencies
.core/vendor/
node_modules/

# Local config and runtime files
.core/.env
.core/.env.backup
.core/.env.production
.core/bootstrap/cache/*.php
.core/storage/*.key
.core/storage/app/*
.core/storage/framework/cache/*
.core/storage/framework/sessions/*
.core/storage/framework/views/*
.core/storage/logs/*
.core/.phpunit.result.cache
.core/.phpunit.cache

# Deploy settings (server login and path) - never commit these
deploy.env
deploy.env.*
!deploy.env.example

# Content uploaded on the server
/images/*
/media/*
/img

.DS_Store

deploy.sh
