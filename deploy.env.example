# Copy to deploy.env (git-ignored) and fill in. Read by deploy.sh.

# one.com SSH login: Control Panel -> Advanced settings -> SSH
DEPLOY_HOST=ssh.ww2maps.net
DEPLOY_USER=ww2maps.net
DEPLOY_PORT=22

# Folder on the server that holds index.php, css/, js/, images/, media/ and .core/
# (log in once with ssh and run "pwd" inside the web root to get it)
DEPLOY_PATH=/path/to/the/web/root

# PHP binary on the server for artisan (must be 8.3 or newer)
DEPLOY_PHP=php

# Branch that is allowed to go live
DEPLOY_BRANCH=main
